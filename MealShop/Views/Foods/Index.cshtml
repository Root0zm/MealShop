@model FoodsIndexViewModel

@{
    ViewData["Title"] = "Danh sách thực phẩm & món ăn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h3 mb-0 text-success fw-bold">Danh sách thực phẩm & món ăn</h2>
    <span class="badge bg-light text-dark border">
        Tổng số: <strong>@Model.PagedFoods.TotalCount</strong> bản ghi
    </span>
</div>

<!-- Khung tim kiem va bo loc -->
<div class="card mb-4 shadow-sm border-0 bg-light">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-5">
                <label for="q" class="form-label fw-semibold">Tìm kiếm theo tên</label>
                <input type="text" class="form-control" id="q" name="q" value="@Model.Q" placeholder="Nhập tên tiếng Việt (không dấu hoặc có dấu)..." />
            </div>

            <div class="col-md-3">
                <label for="kind" class="form-label fw-semibold">Loại</label>
                <select class="form-select" id="kind" name="kind">
                    <option value="">-- Tất cả loại --</option>
                    <option value="dish" selected="@(Model.Kind == "dish" ? "selected" : null)">Món ăn (dish)</option>
                    <option value="ingredient" selected="@(Model.Kind == "ingredient" ? "selected" : null)">Nguyên liệu (ingredient)</option>
                </select>
            </div>

            <div class="col-md-4">
                <label for="category" class="form-label fw-semibold">Danh mục</label>
                <select class="form-select" id="category" name="category">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <option value="@cat" selected="@(Model.Category == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Xóa bộ lọc
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bang hien thi du lieu -->
@if (Model.PagedFoods.Items.Count == 0)
{
    <div class="alert alert-warning text-center" role="alert">
        Không tìm thấy thực phẩm nào phù hợp với điều kiện tìm kiếm.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-success">
                <tr>
                    <th scope="col" style="width: 80px;">Mã</th>
                    <th scope="col">Tên thực phẩm</th>
                    <th scope="col" style="width: 130px;">Phân loại</th>
                    <th scope="col">Danh mục</th>
                    <th scope="col" class="text-end">Kcal</th>
                    <th scope="col" class="text-end">Đạm (g)</th>
                    <th scope="col" class="text-end">Béo (g)</th>
                    <th scope="col" class="text-end">Carb (g)</th>
                    <th scope="col" class="text-center" style="width: 100px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PagedFoods.Items)
                {
                    <tr>
                        <td class="text-muted fw-bold">@item.Id</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold text-dark">
                                @item.NameVi
                            </a>
                        </td>
                        <td>
                            @if (item.Kind == "dish")
                            {
                                <span class="badge bg-primary">Món ăn</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Nguyên liệu</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">@(item.CategoryVi ?? "-")</small>
                        </td>
                        <td class="text-end fw-semibold">@(item.Kcal?.ToString("N1") ?? "-")</td>
                        <td class="text-end">@(item.Protein?.ToString("N1") ?? "-")</td>
                        <td class="text-end">@(item.Fat?.ToString("N1") ?? "-")</td>
                        <td class="text-end">@(item.Carb?.ToString("N1") ?? "-")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">
                                Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Thanh phan trang -->
    @if (Model.PagedFoods.TotalPages > 1)
    {
        <nav aria-label="Phân trang" class="mt-4 d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                Trang <strong>@Model.PagedFoods.Page</strong> / <strong>@Model.PagedFoods.TotalPages</strong>
                (Hiển thị @Model.PagedFoods.Items.Count trên tổng số @Model.PagedFoods.TotalCount)
            </div>

            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.PagedFoods.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.PagedFoods.Page - 1)"
                       asp-route-q="@Model.Q"
                       asp-route-kind="@Model.Kind"
                       asp-route-category="@Model.Category">
                        &laquo; Trước
                    </a>
                </li>

                @{
                    var startPage = Math.Max(1, Model.PagedFoods.Page - 2);
                    var endPage = Math.Min(Model.PagedFoods.TotalPages, Model.PagedFoods.Page + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-q="@Model.Q" asp-route-kind="@Model.Kind" asp-route-category="@Model.Category">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (var p = startPage; p <= endPage; p++)
                {
                    <li class="page-item @(p == Model.PagedFoods.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-q="@Model.Q"
                           asp-route-kind="@Model.Kind"
                           asp-route-category="@Model.Category">
                            @p
                        </a>
                    </li>
                }

                @if (endPage < Model.PagedFoods.TotalPages)
                {
                    @if (endPage < Model.PagedFoods.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@Model.PagedFoods.TotalPages" asp-route-q="@Model.Q" asp-route-kind="@Model.Kind" asp-route-category="@Model.Category">@Model.PagedFoods.TotalPages</a>
                    </li>
                }

                <li class="page-item @(!Model.PagedFoods.HasNextPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.PagedFoods.Page + 1)"
                       asp-route-q="@Model.Q"
                       asp-route-kind="@Model.Kind"
                       asp-route-category="@Model.Category">
                        Sau &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
}
