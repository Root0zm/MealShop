@model FoodDetailsViewModel

@{
    ViewData["Title"] = $"Chi tiết: {Model.NameVi}";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Quay lại danh sách
    </a>
</div>

<!-- Thong tin chung cua mon an -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold text-success mb-1">@Model.NameVi</h1>
                @if (!string.IsNullOrEmpty(Model.NameEn))
                {
                    <p class="text-muted fst-italic mb-2">@Model.NameEn</p>
                }
            </div>
            <div class="d-flex gap-2 align-items-center">
                @if (Model.Kind == "dish")
                {
                    <span class="badge bg-primary fs-6">Món ăn</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6">Nguyên liệu</span>
                }

                @if (Model.UsableAsComponent)
                {
                    <span class="badge bg-info text-dark">Dùng làm thành phần được</span>
                }

                @if (Model.IsSellable)
                {
                    <span class="badge bg-success">Bán trên Menu</span>
                }
            </div>
        </div>

        <div class="row mt-3 text-muted small">
            <div class="col-sm-4">
                <strong>Mã ID:</strong> #@Model.Id
            </div>
            <div class="col-sm-4">
                <strong>Danh mục:</strong> @(Model.CategoryVi ?? "Chưa phân loại")
            </div>
            <div class="col-sm-4">
                <strong>Cờ năng lượng:</strong> @(Model.EnergyFlag ?? "Bình thường")
            </div>
        </div>
    </div>
</div>

<!-- Canh bao du lieu nghi van (IsSuspect) -->
@if (Model.IsSuspect)
{
    <div class="alert alert-danger d-flex align-items-center shadow-sm" role="alert">
        <div class="me-2 fs-4">⚠️</div>
        <div>
            <strong>Cảnh báo chất lượng dữ liệu (Nghi vấn):</strong>
            <span>@(string.IsNullOrEmpty(Model.QaNote) ? "Dữ liệu dinh dưỡng của thực phẩm này có sai lệch hoặc bất thường trong dataset gốc." : Model.QaNote)</span>
        </div>
    </div>
}

<div class="row g-4">
    <!-- Bang gia tri dinh duong tham chieu tu dataset (tinh tren 100g) -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-success text-white fw-bold">
                Dinh dưỡng tham chiếu dataset (trên 100g)
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <tbody>
                            <tr class="table-light">
                                <th colspan="3" class="text-success fw-bold">Nhóm Năng lượng & Đa lượng</th>
                            </tr>
                            <tr>
                                <td class="ps-3">Năng lượng</td>
                                <td class="text-end fw-bold">@(Model.Kcal?.ToString("N1") ?? "-")</td>
                                <td style="width: 80px;">kcal</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Nước</td>
                                <td class="text-end">@(Model.Water?.ToString("N1") ?? "-")</td>
                                <td>g</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Chất đạm (Protein)</td>
                                <td class="text-end fw-bold text-primary">@(Model.Protein?.ToString("N1") ?? "-")</td>
                                <td>g</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Chất béo (Fat / Lipid)</td>
                                <td class="text-end fw-bold text-danger">@(Model.Fat?.ToString("N1") ?? "-")</td>
                                <td>g</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Chất bột đường (Carb)</td>
                                <td class="text-end fw-bold text-warning">@(Model.Carb?.ToString("N1") ?? "-")</td>
                                <td>g</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Chất xơ (Fiber)</td>
                                <td class="text-end">@(Model.Fiber?.ToString("N1") ?? "-")</td>
                                <td>g</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Cholesterol</td>
                                <td class="text-end">@(Model.Cholesterol?.ToString("N1") ?? "-")</td>
                                <td>mg</td>
                            </tr>

                            <tr class="table-light">
                                <th colspan="3" class="text-success fw-bold">Khoáng chất</th>
                            </tr>
                            <tr>
                                <td class="ps-3">Canxi (Calcium)</td>
                                <td class="text-end">@(Model.Calcium?.ToString("N1") ?? "-")</td>
                                <td>mg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Phốt pho (Phosphorus)</td>
                                <td class="text-end">@(Model.Phosphorus?.ToString("N1") ?? "-")</td>
                                <td>mg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Sắt (Iron)</td>
                                <td class="text-end">@(Model.Iron?.ToString("N2") ?? "-")</td>
                                <td>mg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Natri (Sodium)</td>
                                <td class="text-end">@(Model.Sodium?.ToString("N1") ?? "-")</td>
                                <td>mg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Kali (Potassium)</td>
                                <td class="text-end">@(Model.Potassium?.ToString("N1") ?? "-")</td>
                                <td>mg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Kẽm (Zinc)</td>
                                <td class="text-end">@(Model.Zinc?.ToString("N2") ?? "-")</td>
                                <td>mg</td>
                            </tr>

                            <tr class="table-light">
                                <th colspan="3" class="text-success fw-bold">Vitamin</th>
                            </tr>
                            <tr>
                                <td class="ps-3">Vitamin A</td>
                                <td class="text-end">@(Model.VitaminA?.ToString("N1") ?? "-")</td>
                                <td>µg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Beta-Carotene</td>
                                <td class="text-end">@(Model.BetaCarotene?.ToString("N1") ?? "-")</td>
                                <td>µg</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Vitamin C</td>
                                <td class="text-end">@(Model.VitaminC?.ToString("N1") ?? "-")</td>
                                <td>mg</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sach cong thuc & So sanh dinh duong -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                <span>Công thức định lượng (Recipes)</span>
                @if (Model.CalculatedNutrition != null)
                {
                    <span class="badge bg-light text-primary">
                        Tổng: @Model.CalculatedNutrition.TotalGrams g
                    </span>
                }
            </div>
            <div class="card-body">
                @if (Model.Components.Count == 0)
                {
                    <div class="alert alert-secondary text-center my-4" role="alert">
                        <em>Món ăn chưa có công thức thành phần.</em>
                    </div>
                }
                else
                {
                    <!-- Bang thanh phan -->
                    <h6 class="fw-bold text-secondary mb-2">Thành phần nguyên liệu:</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Nguyên liệu</th>
                                    <th class="text-end">Gram</th>
                                    <th class="text-end">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in Model.Components)
                                {
                                    <tr>
                                        <td>
                                            <a asp-action="Details" asp-route-id="@comp.ComponentId" class="text-decoration-none">
                                                @comp.ComponentNameVi
                                            </a>
                                        </td>
                                        <td class="text-end fw-semibold">@comp.Grams.ToString("N1") g</td>
                                        <td class="text-end text-muted small">@comp.Percentage.ToString("N1")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Canh bao thanh phan IsSuspect -->
                    @if (Model.CalculatedNutrition?.SuspectComponentWarnings.Count > 0)
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <div class="fw-bold mb-1">Lưu ý thành phần công thức:</div>
                            <ul class="mb-0 ps-3">
                                @foreach (var warning in Model.CalculatedNutrition.SuspectComponentWarnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Bang so sanh tinh toan vs tham chieu -->
                    @if (Model.CalculatedNutrition != null)
                    {
                        <h6 class="fw-bold text-secondary mb-2">Đối soát dinh dưỡng (trên 100g):</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle text-center mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-start">Chỉ số /100g</th>
                                        <th>Tính từ công thức</th>
                                        <th>Tham chiếu</th>
                                        <th>Lệch</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        void RenderRow(string label, NutrientComparison item, string unit = "")
                                        {
                                            <tr>
                                                <td class="text-start fw-semibold">@label</td>
                                                <td>@item.Calculated.ToString("N1") @unit</td>
                                                <td class="text-muted">@(item.Reference?.ToString("N1") ?? "-") @unit</td>
                                                <td>
                                                    @if (item.DiffPercent.HasValue)
                                                    {
                                                        var diff = item.DiffPercent.Value;
                                                        var badgeClass = Math.Abs(diff) <= 15 ? "text-success fw-bold" : (Math.Abs(diff) <= 50 ? "text-warning fw-bold" : "text-danger fw-bold");
                                                        <span class="@badgeClass">
                                                            @(diff > 0 ? $"+{diff}%" : $"{diff}%")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }

                                        RenderRow("Năng lượng (kcal)", Model.CalculatedNutrition.Kcal);
                                        RenderRow("Chất đạm (protein)", Model.CalculatedNutrition.Protein, "g");
                                        RenderRow("Chất béo (fat)", Model.CalculatedNutrition.Fat, "g");
                                        RenderRow("Chất bột đường (carb)", Model.CalculatedNutrition.Carb, "g");
                                        RenderRow("Chất xơ (fiber)", Model.CalculatedNutrition.Fiber, "g");
                                        RenderRow("Nước (water)", Model.CalculatedNutrition.Water, "g");
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
