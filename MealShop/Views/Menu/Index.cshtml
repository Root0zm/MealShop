@model MealShop.ViewModels.MenuIndexViewModel
@{
    ViewData["Title"] = "Thực đơn hôm nay";
}

<div class="menu-page">
    <div class="menu-header mb-4">
        <h1 class="menu-title">Thực đơn hôm nay</h1>
        <p class="menu-subtitle">
            Chọn một món chính, thêm món kèm. Năng lượng, đạm, béo và bột đường hiện ngay trên từng suất.
        </p>
    </div>

    <!-- Hang Chon theo muc tieu -->
    <div class="goal-filter-bar mb-3 d-flex flex-wrap align-items-center gap-2">
        <span class="goal-label me-2">Chọn theo mục tiêu</span>
        
        <a asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.Search"
           class="goal-chip @(string.IsNullOrEmpty(Model.Goal) ? "active" : "")">
            Tất cả
        </a>

        <a asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-goal="@(Model.Goal == "under-400" ? null : "under-400")" asp-route-search="@Model.Search"
           class="goal-chip @(Model.Goal == "under-400" ? "active" : "")">
            Dưới 400 kcal
        </a>

        <a asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-goal="@(Model.Goal == "high-protein" ? null : "high-protein")" asp-route-search="@Model.Search"
           class="goal-chip @(Model.Goal == "high-protein" ? "active" : "")">
            Giàu đạm (≥ 20g)
        </a>

        <a asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-goal="@(Model.Goal == "low-fat" ? null : "low-fat")" asp-route-search="@Model.Search"
           class="goal-chip @(Model.Goal == "low-fat" ? "active" : "")">
            Ít béo (≤ 5g)
        </a>
    </div>

    <!-- Hang Tab thuc don -->
    <div class="menu-tabs-bar mb-4 d-flex flex-wrap gap-2">
        @foreach (var tab in Model.Tabs)
        {
            var isActive = string.Equals(Model.ActiveTab, tab, StringComparison.OrdinalIgnoreCase);
            <a asp-action="Index" asp-route-tab="@tab" asp-route-goal="@Model.Goal" asp-route-search="@Model.Search"
               class="tab-btn @(isActive ? "active" : "")">
                @tab
            </a>
        }
    </div>

    <!-- Khu vuc chinh hai cot -->
    <div class="row g-4 align-items-start">
        <!-- Cot trai: Danh sach mon -->
        <div class="col-lg-8">
            @if (Model.ActiveTab == "Món chính")
            {
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
                    <h2 class="h4 fw-bold mb-0">Món chính</h2>
                    <span class="text-secondary small">Dinh dưỡng tham chiếu theo khẩu phần</span>
                </div>

                @if (Model.MainDishes.Count > 0)
                {
                    <div class="dish-grid mb-5">
                        @foreach (var dish in Model.MainDishes)
                        {
                            <partial name="_DishCard" model="dish" />
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border p-4 text-center text-muted mb-5">
                        Không có món chính nào phù hợp với bộ lọc hiện tại.
                    </div>
                }

                @if (Model.SideItems.Count > 0)
                {
                    <div class="sides-section mt-4 pt-3 border-top">
                        <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
                            <h2 class="h5 fw-bold mb-0">Thêm món kèm</h2>
                            <span class="text-secondary small">Khẩu phần nhỏ để ăn kèm</span>
                        </div>
                        <div class="side-grid">
                            @foreach (var side in Model.SideItems)
                            {
                                <partial name="_SideItem" model="side" />
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
                    <h2 class="h4 fw-bold mb-0">@Model.ActiveTab</h2>
                    <span class="text-secondary small">Khẩu phần tính theo suất chuẩn</span>
                </div>

                @if (Model.CurrentTabItems.Count > 0)
                {
                    <div class="side-grid">
                        @foreach (var item in Model.CurrentTabItems)
                        {
                            <partial name="_SideItem" model="item" />
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border p-4 text-center text-muted">
                        Chưa có món nào trong nhóm này hoặc không thỏa mãn bộ lọc.
                    </div>
                }
            }
        </div>

        <!-- Cot phai: Gio Bua cua ban (MiniCart) -->
        <div class="col-lg-4">
            <div id="miniCartContainer" class="sticky-top" style="top: 24px; z-index: 10;">
                @await Component.InvokeAsync("MiniCart")
            </div>
        </div>
    </div>

    <!-- Ghi chu dinh duong chan trang (Quyet dinh 3) -->
    <div class="footer-note mt-5 pt-4 border-top">
        <p class="text-secondary small mb-0">
            * Dinh dưỡng tính theo khối lượng nguyên liệu, chưa tính hao hụt khi chế biến.
            Giá trị dinh dưỡng của từng khẩu phần được tính từ bảng thành phần thực phẩm tham chiếu nhân với khối lượng khẩu phần.
        </p>
    </div>
</div>
