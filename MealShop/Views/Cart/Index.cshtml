@model MealShop.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Bữa ăn của bạn";
}

<div class="container py-4" style="max-width: 960px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #1A3026;">Bữa ăn của bạn</h1>
            <p class="text-muted mb-0">Kiểm tra dinh dưỡng và các món ăn đã chọn</p>
        </div>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            ← Tiếp tục chọn món
        </a>
    </div>

    @if (Model.Warnings.Count > 0)
    {
        @foreach (var warning in Model.Warnings)
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@warning
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
            </div>
        }
    }

    @if (Model.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5" style="background-color: #FAFCFA;">
            <div class="mb-3 text-muted">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="8" cy="21" r="1"></circle>
                    <circle cx="19" cy="21" r="1"></circle>
                    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                </svg>
            </div>
            <h5 class="fw-bold mb-2">Bữa ăn chưa có món nào</h5>
            <p class="text-muted mb-4">Hãy ghé qua thực đơn để chọn các món ăn dinh dưỡng cho bữa hôm nay.</p>
            <div>
                <a asp-controller="Menu" asp-action="Index" class="btn text-white rounded-pill px-4 py-2" style="background-color: #2F7D4F;">
                    Khám phá thực đơn
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Danh sach mon an -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="fw-bold" style="color: #1A3026;">Danh sách món ăn (@Model.TotalItemsCount món)</span>
                        <form asp-controller="Cart" asp-action="Clear" method="post" class="m-0">
                            <button type="submit" class="btn btn-link text-danger p-0 text-decoration-none small" onclick="return confirm('Bạn có chắc muốn xóa tất cả món?');">
                                Xóa tất cả
                            </button>
                        </form>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div>
                                            <h6 class="fw-bold mb-1" style="color: #1A3026;">@item.FoodName</h6>
                                            <div class="small text-muted">
                                                @item.PortionGrams.ToString("N0") g · @(item.Kcal.HasValue ? $"{item.Kcal.Value:N0} kcal" : "chưa đủ dữ liệu") · <span style="color: #B4390F;">@item.UnitPrice.ToVnd()</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-4 ms-auto">
                                        <!-- Bo cong tru so luong -->
                                        <div class="d-flex align-items-center border rounded-pill px-2 py-1" style="border-color: #DDE5DF !important;">
                                            <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline m-0">
                                                <input type="hidden" name="portionId" value="@item.PortionId" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" aria-label="Giảm số lượng @item.FoodName" style="color: #2F7D4F; width: 24px; height: 24px; line-height: 1;">
                                                    <span class="fw-bold fs-6">−</span>
                                                </button>
                                            </form>

                                            <span class="px-2 fw-bold text-center" style="min-width: 28px; font-size: 0.95rem;">@item.Quantity</span>

                                            <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline m-0">
                                                <input type="hidden" name="portionId" value="@item.PortionId" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" aria-label="Tăng số lượng @item.FoodName" style="color: #2F7D4F; width: 24px; height: 24px; line-height: 1;" @(item.Quantity >= 20 ? "disabled" : "")>
                                                    <span class="fw-bold fs-6">+</span>
                                                </button>
                                            </form>
                                        </div>

                                        <div class="text-end" style="min-width: 90px;">
                                            <div class="fw-bold" style="color: #B4390F;">@item.LinePrice.ToVnd()</div>
                                        </div>

                                        <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0">
                                            <input type="hidden" name="portionId" value="@item.PortionId" />
                                            <button type="submit" class="btn btn-link text-muted p-0" title="Xóa món" aria-label="Xóa @item.FoodName">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M18 6L6 18M6 6l12 12"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tong ket dinh duong va thanh toan -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px;">
                    <h5 class="fw-bold mb-3" style="color: #1A3026;">Tóm tắt bữa ăn</h5>

                    <partial name="_CartNutrition" model="Model" />

                    <hr class="my-3" style="border-color: #DDE5DF;">

                    <!-- Tong tien -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold" style="color: #1A3026;">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold" style="color: #B4390F;">@Model.TotalAmount.ToVnd()</span>
                    </div>

                    <!-- Nut dat hang -->
                    <a asp-controller="Orders" asp-action="Checkout" class="btn text-white w-100 py-2 rounded-pill fw-bold text-center text-decoration-none" style="background-color: #2F7D4F;">
                        Tiến hành đặt món
                    </a>
                </div>
            </div>
        </div>
    }
</div>