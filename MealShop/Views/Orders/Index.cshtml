@model List<MealShop.Models.Order>

@{
    ViewData["Title"] = "Đơn của tôi";
}

<div class="container py-4" style="max-width: 960px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #1A3026;">Đơn hàng của bạn</h1>
            <p class="text-muted mb-0">Lịch sử các bữa ăn lành mạnh bạn đã đặt tại MealShop</p>
        </div>
        <a asp-controller="Menu" asp-action="Index" class="btn text-white rounded-pill px-4" style="background-color: #2F7D4F;">
            + Đặt bữa mới
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5" style="background-color: #FAFCFA;">
            <div class="mb-3 text-muted">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M7 15h10M7 9h10"></path>
                </svg>
            </div>
            <h5 class="fw-bold mb-2">Bạn chưa có đơn hàng nào</h5>
            <p class="text-muted mb-4">Hãy khám phá thực đơn đa dạng và chọn cho mình bữa ăn phù hợp ngay hôm nay.</p>
            <div>
                <a asp-controller="Menu" asp-action="Index" class="btn text-white rounded-pill px-4 py-2" style="background-color: #2F7D4F;">
                    Khám phá thực đơn
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #F4F7F2;">
                        <tr class="small text-muted">
                            <th class="ps-4">Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Tổng thanh toán</th>
                            <th>Năng lượng</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="font-monospace fw-bold text-dark">@order.PublicCode</span>
                                </td>
                                <td class="small">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold" style="color: #B4390F;">@order.TotalAmount.ToVnd()</td>
                                <td class="small fw-semibold" style="color: #2F7D4F;">@(order.TotalKcal.HasValue ? $"{order.TotalKcal:N0} kcal" : "Chưa đủ dữ liệu")</td>
                                <td>
                                    <span class="badge @(order.Status == "Completed" ? "bg-success" : order.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                        @OrderStatus.Label(order.Status)
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-1">
                                        Xem chi tiết
                                    </a>
                                    <form asp-action="Reorder" asp-route-id="@order.Id" method="post" class="d-inline m-0">
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                            Đặt lại
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>