@model MealShop.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5" style="background-color: #FAFCFA;">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: #EAF4EE; color: #2F7D4F; font-size: 2rem;">
                ✓
            </span>
        </div>

        <h1 class="h3 fw-bold mb-2" style="color: #1A3026;">Đặt hàng thành công!</h1>
        <p class="text-muted mb-4">Cảm ơn bạn đã đặt bữa ăn dinh dưỡng tại MealShop. Đơn hàng của bạn đã được chuyển tới bếp.</p>

        <!-- Khung ma don hang cong khai noi bat -->
        <div class="p-4 rounded-4 mb-4 border" style="background-color: #FFFFFF; border-color: #DDE5DF !important;">
            <div class="text-muted small fw-semibold text-uppercase mb-1" style="letter-spacing: 0.5px;">Mã đơn hàng của bạn</div>
            <div class="d-flex align-items-center justify-content-center gap-2 my-2">
                <span id="orderPublicCode" class="fs-2 fw-bold text-dark font-monospace px-3 py-1 rounded" style="background: #F4F7F2; letter-spacing: 2px;">
                    @Model.PublicCode
                </span>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="navigator.clipboard.writeText('@Model.PublicCode'); alert('Đã sao chép mã đơn: @Model.PublicCode');">
                    Sao chép
                </button>
            </div>
            <div class="text-danger small fw-semibold mt-2">
                Hãy lưu lại mã đơn này kèm số điện thoại <strong>@Model.PhoneNumber</strong> để tra cứu tình trạng đơn hàng tại trang <a asp-action="Track" class="text-decoration-underline">Tra cứu đơn</a>!
            </div>
        </div>

        <!-- Thong tin chi tiet don -->
        <div class="text-start bg-white p-4 rounded-4 border mb-4" style="border-color: #DDE5DF !important;">
            <h6 class="fw-bold mb-3 border-bottom pb-2">Thông tin giao nhận</h6>
            <div class="row g-2 small">
                <div class="col-sm-4 text-muted">Người nhận:</div>
                <div class="col-sm-8 fw-semibold">@Model.CustomerName</div>

                <div class="col-sm-4 text-muted">Số điện thoại:</div>
                <div class="col-sm-8 fw-semibold">@Model.PhoneNumber</div>

                <div class="col-sm-4 text-muted">Địa chỉ nhận hàng:</div>
                <div class="col-sm-8">@Model.ShippingAddress</div>

                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="col-sm-4 text-muted">Ghi chú:</div>
                    <div class="col-sm-8">@Model.Note</div>
                }

                <div class="col-sm-4 text-muted">Tổng thanh toán:</div>
                <div class="col-sm-8 fw-bold" style="color: #B4390F;">@Model.TotalAmount.ToVnd() (COD)</div>

                <div class="col-sm-4 text-muted">Tổng năng lượng:</div>
                <div class="col-sm-8 fw-bold" style="color: #2F7D4F;">@(Model.TotalKcal.HasValue ? $"{Model.TotalKcal:N0} kcal" : "Chưa đủ dữ liệu")</div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-action="Track" class="btn btn-outline-success rounded-pill px-4 py-2">
                Tra cứu đơn hàng
            </a>
            <a asp-controller="Menu" asp-action="Index" class="btn text-white rounded-pill px-4 py-2" style="background-color: #2F7D4F;">
                Tiếp tục xem thực đơn
            </a>
        </div>
    </div>
</div>